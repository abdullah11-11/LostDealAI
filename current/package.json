{
  "name": "lostdeal-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:auth-rls": "node --env-file=.env.local scripts/test-auth-rls.mjs",
    "test:app-auth": "node --env-file=.env.local scripts/test-app-auth.mjs",
    "test:csv": "node --import tsx --test tests/csv-import.test.ts",
    "test:deals": "node --import tsx --test tests/deals-query.test.ts",
    "test:ai": "node --import tsx --test tests/ai-analysis.test.ts",
    "test:scoring": "node --import tsx --test tests/recovery-scoring.test.ts",
    "test:dashboard": "node --import tsx --test tests/dashboard-metrics.test.ts tests/dashboard-runtime.test.ts",
    "test:intelligence": "node --import tsx --test tests/deal-intelligence.test.ts",
    "test:demo": "node --import tsx --test tests/demo-data.test.ts",
    "test:security": "node --import tsx --test tests/security-hardening.test.ts",
    "test:ui": "node --import tsx --test tests/ui-polish.test.ts",
    "test:smart-import": "node --import tsx --test tests/smart-import.test.ts",
    "test:qa": "node --import tsx --test tests/prompt14-qa.test.ts",
    "test:commercial": "node --import tsx --test tests/prompt15-commercial.test.ts",
    "test:commercial-packaging": "node --import tsx --test tests/prompt15-1-plan-packaging.test.ts",
    "test:auto-convert": "node --import tsx --test tests/prompt15-2-auto-convert.test.ts",
    "test:deep-analysis": "node --import tsx --test tests/prompt15-3-deep-analysis.test.ts",
    "test:deep-runtime": "node --import tsx --test tests/prompt15-3-1-runtime-hardening.test.ts",
    "test:usage-hotfix": "node --import tsx --test tests/prompt15-3-2-usage-reservation-hotfix.test.ts",
    "test:recovery-sort-hotfix": "node --import tsx --test tests/prompt15-3-3-recovery-sort-auth-hotfix.test.ts",
    "test:deep-semantic-hotfix": "node --import tsx --test tests/prompt15-3-4-deep-semantic-validator-hotfix.test.ts",
    "test:deep-semantic-final": "node --import tsx --test tests/prompt15-3-5-final-deep-semantic-reliability.test.ts",
    "test:deep-runtime-final": "node --import tsx --test tests/prompt15-3-6-final-deep-runtime-closure.test.ts",
    "test:omnibus": "node --import tsx --test tests/prompt15-3-7-final-omnibus-qa.test.ts",
    "test:billing-recovery": "node --import tsx --test tests/prompt16-reupgrade-rejection-recovery.test.ts",
    "benchmark:auto-convert": "node --import tsx scripts/benchmark-auto-convert.ts",
    "benchmark:analysis": "node --env-file=.env.local --import tsx scripts/benchmark-analysis-models.ts",
    "test:app-deals": "node --env-file=.env.local scripts/test-app-deals.mjs",
    "test:csv-rls": "node --env-file=.env.local --import tsx scripts/test-csv-import-rls.mjs",
    "test:app-csv": "node --env-file=.env.local scripts/test-app-csv-import.mjs",
    "test:security-live": "node scripts/test-security-live.mjs",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit"
  },
  "dependencies": {
    "@paddle/paddle-js": "1.6.5",
    "@paddle/paddle-node-sdk": "3.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "openai": "^7.5.0",
    "papaparse": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "ws": "8.21.0",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "miniflare": {
      "undici": "7.29.1"
    },
    "vinext": {
      "image-size": "2.0.4"
    },
    "@babel/core": "7.29.6",
    "sharp": "0.35.5"
  },
  "type": "module",
  "displayName": "LostDeal AI"
}
